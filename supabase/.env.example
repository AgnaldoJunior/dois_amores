# Segredos do Supabase (Auth e Edge Functions). Copie para supabase/.env e preencha.
# Este arquivo NUNCA vai para o git. Usado por `supabase config push` e `supabase secrets set --env-file`.

# Login com Google — Google Cloud → Google Auth Platform → Clients (Web application)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# E-mails de confirmação e recuperação — Gmail dedicado + senha de app
# https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=

# IA — https://aistudio.google.com/apikey
# Copie esta linha para supabase/functions/.env (lido pela Edge Function "ai").
GEMINI_API_KEY=
# Opcionais: modelo principal e reservas (separados por vírgula). Padrão:
# gemini-3.5-flash-lite, com gemini-3.1-flash-lite de reserva.
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODELS=
# Chamadas de IA por pessoa por dia (padrão 20).
# AI_DAILY_LIMIT=
