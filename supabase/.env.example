# Segredos do Supabase (Auth e Edge Functions). Copie para supabase/.env e preencha.
# Este arquivo NUNCA vai para o git. Usado por `supabase config push` e `supabase secrets set --env-file`.

# Login com Google — Google Cloud → Google Auth Platform → Clients (Web application)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# E-mails de confirmação e recuperação — Gmail dedicado + senha de app
# https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=

# IA (Fase 6) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
