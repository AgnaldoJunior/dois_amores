# Front-end (Vite). Copie para .env.local e preencha.
# Local: valores de `npx supabase status -o env` (API_URL e ANON_KEY).
# Produção: Supabase → Project Settings → API Keys (configure também na Vercel).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Chave pública (anon / publishable). NUNCA coloque a service_role aqui.
VITE_SUPABASE_ANON_KEY=
